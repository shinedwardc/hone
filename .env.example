# Copy this file to .env and fill in the key for whichever provider you use.

# --- Provider selection (all optional; flags override these) ---
# HONE_PROVIDER=openrouter     # openrouter | anthropic | ollama
# HONE_MODEL=                  # override the provider's default model
# HONE_BASE_URL=               # override the provider's default endpoint
# HONE_MAX_TOKENS=8192
# HONE_SANDBOX_ROOT=./examples/calculator

# --- Keys (only the selected provider's key is required) ---
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
